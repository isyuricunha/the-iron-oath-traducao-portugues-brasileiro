{
	UniqueName: "TutorialAbilities",
	Catalyst: "NONE",
	QuestName: "Quest.CampaignPrologue",
	PartyMakeupReq: "ANY",
	FireImmediately: "true",
	AutoAdvanceTime: "4",
	MetaData: "tutorialAbilities",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Abilities", "As habilidades únicas do seu personagem têm um número limitado de 'Cargas' disponíveis ao longo de uma masmorra. As cargas podem ser restauradas acampando ou usando certos suprimentos. Se uma habilidade ficar sem cargas, ela ainda pode ser usada, mas com um grande custo de Vida para o personagem.\n\nCom o inimigo avançando sobre nós, podemos armar uma armadilha usando a habilidade 'Return to Cinder' do Pirolanceiro no hexágono indicado."],
	Text: [""],
}
