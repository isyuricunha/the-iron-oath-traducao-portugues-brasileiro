# FreeInference API key (required for a real run). Create one at https://freeinference.org
FREEINFERENCE_API_KEY=

# Optional overrides. Leave them commented out to use the defaults shown.
# TRANSLATION_BASE_URL=https://freeinference.org/v1
# TRANSLATION_MODEL=deepseek-v4-flash
# GLOSSARY_MODEL=
# TRANSLATION_REASONING_EFFORT=max

# Strip accents from published text (the shipped fonts lack the glyphs)
# TRANSLATION_STRIP_DIACRITICS=1
