	MetaData: "tutorialBasicAttack",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Basic Attacks", "Each character has a basic attack available to them. Unlike abilities, basic attacks have unlimited uses but are subject to an accuracy and evasion check.\n\nPerform a basic attack on the enemy by clicking 'LMB' <sprite name=\"PC-leftClick\"> on the indicated hex.^Each character has a basic attack available to them. Unlike abilities, basic attacks have unlimited uses but are subject to an accuracy and evasion check.\n\nPerform a basic attack on the enemy by clicking <sprite name=\"XboxOne-a\"> on the indicated hex."],
	Text: [""],
}
