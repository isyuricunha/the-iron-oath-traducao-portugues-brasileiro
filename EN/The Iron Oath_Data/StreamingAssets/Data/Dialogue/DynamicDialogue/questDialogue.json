}
{
	UniqueName: "TutorialSpirit",
	Catalyst: "NONE",
	QuestName: "Quest.CampaignPrologue",
	PartyMakeupReq: "ANY",
	FireImmediately: "true",
	AutoAdvanceTime: "4",
	MetaData: "tutorialspirit",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Morale|Gaining and Losing Morale|Consequences of Low Morale|Benefits of High Morale", "Your Pugilist has killed an enemy and gained Morale, which is represented by the white bar under each character's portrait. Morale is a character's state of mind for the current mission.|Morale is gained and lost through various combat triggers. Landing a killing blow will increase morale, while suffering a critical strike from an enemy will lower it.|When Morale is under 25, there is a chance for that character to delay or pass their turn. Additionally, a character with low Morale will accrue more Fatigue from missions, and will also lose 'Loyalty' towards the company.|When Morale is over 75, all negative conditons applied to that character will have their duration reduced by 1 (to a minimum duration of 1 Round)."],
	Text: [""],
}
{
	UniqueName: "TutorialFlanking",
	Catalyst: "NONE",
	QuestName: "Quest.CampaignPrologue",
	PartyMakeupReq: "ANY",
	FireImmediately: "true",
	AutoAdvanceTime: "4",
	MetaData: "tutorialflanking",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Flanking", "Targets are considered Flanked whenever you occupy two opposing hexes around their location. All attacks against flanked targets deal 15% extra damage and cannot miss.\n\nIf your chance to hit with a basic attack is low, it's best to try and flank the enemy first in order to guarantee a hit, or use an ability instead.\n\nLet's move the Guardian into a flanking position and attack the enemy."],
	Text: [""],
}
