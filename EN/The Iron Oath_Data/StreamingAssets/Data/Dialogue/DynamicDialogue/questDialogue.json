	MetaData: "tutorialEndTurn",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Waiting|Using Guard|Issue a Wait Command", "If you don't have a desirable action to perform, you can delay a character's turn until the end of the round by hitting the 'Wait' button.|Alternatively, you can end a character's turn by using the 'Guard' action, which provides a temporary bonus to Defense and Evasion.|Click the 'Wait' button to delay the Stormcaller's turn."],
	Text: [""],
}
{
	UniqueName: "TutorialAbilities",
	Catalyst: "NONE",
	QuestName: "Quest.CampaignPrologue",
	PartyMakeupReq: "ANY",
	FireImmediately: "true",
	AutoAdvanceTime: "4",
	MetaData: "tutorialAbilities",
	Priority: "100",
	ClearQueueOnFinish: "true",
	ToolTip: ["Abilities", "Your character's unique abilities have a limited number of 'Charges' available during the course of a dungeon. Charges can be restored by camping, or by using certain provisions. If an ability runs out of charges, it can still be used, but at a large cost to the character's Health.\n\nWith the enemy advancing on us, we can set a trap by using the Pyrolancer's 'Return to Cinder' ability on the indicated hex."],
	Text: [""],
}
